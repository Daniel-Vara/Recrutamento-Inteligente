# ============================================================
# Configuração do Frontend — Appliety (Plataforma de Recrutamento)
# ============================================================

# URL base da API Django REST Framework
VITE_API_URL=http://localhost:8000/api/v1

# ============================================================
# Configuração do Backend Django (arquivo: backend/.env)
# ============================================================
# Copie este arquivo para backend/.env e preencha os valores:
#
# SECRET_KEY=sua-chave-secreta-aqui
# DEBUG=True
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/appliety_db
#
# Ou use variáveis individuais:
# DB_NAME=appliety_db
# DB_USER=postgres
# DB_PASSWORD=sua-senha
# DB_HOST=localhost
# DB_PORT=5432
#
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# FRONTEND_URL=http://localhost:5173
#
# JWT_ACCESS_MINUTES=120
# JWT_REFRESH_DAYS=14
